---
// Layout for every page except the home page: project case studies, notes, 404.
import { getProfile } from '../lib/profile';
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { name } = await getProfile();
---

<Base title={`${title} · ${name}`} description={description}>
  <div class="wrap">
    <SiteHeader name={name} />
    <main class="page">
      <slot />
    </main>
    <footer class="page-foot">
      <a href="/">← Back home</a>
    </footer>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 24px;
    padding-block: 40px 0;
  }

  .page :global(h1) {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.9rem, 7vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .page-foot {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
</style>
