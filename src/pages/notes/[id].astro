---
import { render, type CollectionEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDate, publishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await publishedNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Page title={note.data.title} description={note.data.summary}>
  <header class="head">
    <p class="label">Homelab notes · {formatDate(note.data.date)}</p>
    <h1>{note.data.title}</h1>
  </header>
  <article class="prose">
    <Content />
  </article>
</Page>

<style>
  .head {
    display: grid;
    gap: 10px;
  }
</style>
